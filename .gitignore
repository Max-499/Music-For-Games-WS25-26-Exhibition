.DS_Store
# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/NoBurstTest/.utmp/
/NoBurstTest/[Ll]ibrary/
/NoBurstTest/[Tt]emp/
/NoBurstTest/[Oo]bj/
/NoBurstTest/[Bb]uild/
/NoBurstTest/[Bb]uilds/
/NoBurstTest/[Ll]ogs/
/NoBurstTest/[Uu]ser[Ss]ettings/
/NoBurstTest/*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be commited to version control.
/NoBurstTest/*.blend1
/NoBurstTest/*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/NoBurstTest/[Mm]emoryCaptures/

# Recordings can get excessive in size
/NoBurstTest/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/NoBurstTest/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
/NoBurstTest/*.DotSettings.user

# Visual Studio cache directory
/NoBurstTest/.vs/

# Gradle cache directory
/NoBurstTest/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
/NoBurstTest/ExportedObj/
/NoBurstTest/.consulo/
/NoBurstTest/*.csproj
/NoBurstTest/*.unityproj
/NoBurstTest/*.sln
/NoBurstTest/*.suo
/NoBurstTest/*.tmp
/NoBurstTest/*.user
/NoBurstTest/*.userprefs
/NoBurstTest/*.pidb
/NoBurstTest/*.booproj
/NoBurstTest/*.svd
/NoBurstTest/*.pdb
/NoBurstTest/*.mdb
/NoBurstTest/*.opendb
/NoBurstTest/*/.VC.db

# Unity3D generated meta files
/NoBurstTest/*.pidb.meta
/NoBurstTest/*.pdb.meta
/NoBurstTest/*.mdb.meta

# Unity3D generated file on crash reports
/NoBurstTest/sysinfo.txt

# Mono auto generated files
/NoBurstTest/mono_crash.*

# Builds
/NoBurstTest/*.apk
/NoBurstTest/*.aab
/NoBurstTest/*.unitypackage
/NoBurstTest/*.unitypackage.meta
/NoBurstTest/*.app

# Crashlytics generated file
/NoBurstTest/crashlytics-build.properties

# TestRunner generated files
/NoBurstTest/InitTestScene*.unity*

# Addressables default ignores, before user customizations
/NoBurstTest/ServerData
/NoBurstTest/[Aa]ssets/StreamingAssets/aa*
/NoBurstTest/[Aa]ssets/AddressableAssetsData/link.xml*
/NoBurstTest/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/NoBurstTest/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/NoBurstTest/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/NoBurstTest/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/NoBurstTest/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/NoBurstTest/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
/NoBurstTest/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

#Further files
/NoBurstTest/.idea/
/NoBurstTest/Assets/Under_Cut.mp4
/NoBurstTest/Assets/Under_Cut.mp4.meta
/NoBurstTest/Assets/Under_Cut.webm
/NoBurstTest/Assets/Under_Cut.webm.meta
/NoBurstTest/Assets/peaks/
/NoBurstTest/Assets/shortened_new.webm
/NoBurstTest/Assets/shortened_new.webm.meta
/NoBurstTest/Assets/shortened_video.mp4
/NoBurstTest/Assets/shortened_video.mp4.meta
/NoBurstTest/Assets/test_screen.ogv
/NoBurstTest/Assets/test_screen.ogv.meta
/NoBurstTest/Assets/test_screen.webm
/NoBurstTest/Assets/test_screen.webm.meta
/NoBurstTest/Assets/under_cut.ogv
/NoBurstTest/Assets/under_cut.ogv.meta
/NoBurstTest/Assets/gate_temp_video.mp4
/NoBurstTest/Assets/gate_temp_video.mp4.meta
/NoBurstTest/Assets/timeline.mov
/NoBurstTest/Assets/timeline.mov.meta